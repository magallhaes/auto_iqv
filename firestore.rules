rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile and session documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // User's detailed operations history & loss diagnostics
      match /orders/{orderId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(orderId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // Historical market quotes snapshots
    match /quotes/{quoteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(quoteId);
      allow update: if false;
      allow delete: if false;
    }
  }
}
